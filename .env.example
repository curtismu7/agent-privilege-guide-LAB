# Optional. Everything has a safe default; Mock needs no tenant and no credentials.
# This file is read by the server (server/src/index.js) beside docker-compose.yml. Mode 600 recommended.
# PORT must be 7826 (this app's one allocated port; server/src/safety.js refuses any other).
PORT=7826
# APG_BIND=127.0.0.1   # loopback only unless you set this on purpose (Docker sets APG_BIND=0.0.0.0 inside the container)
# Start mode. Empty (the default) = Real when the Real switch is enabled (APG_MODE_REAL=1), else Mock.
# MODE=mock           # force the start mode; MODE=real also requires APG_MODE_REAL=1
# This lab is mock-only by design: there is NO live engine and it contacts no Privilege console in any mode.
# APG_MODE_REAL=1     # enable the rule-19 Real switch (the page keeps its simulation banner; Real only changes what the mode switch reports)
# LAB_ALLOWED_HOSTS=agent-privilege-guide.local.ping-devops.com   # extra Host names the lab answers to (comma separated); loopback always works
# SHELF_URL=http://127.0.0.1:4400                                 # link back to the demo shelf (GET /api/shelf)
